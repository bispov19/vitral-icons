[Unit]
Description=Brisa: vigia instalação e remoção de apps

[Path]
# RPM, Flatpak (sistema e usuário) e apps do usuário (inclui web apps do Brave)
PathModified=/usr/share/applications
PathModified=/var/lib/flatpak/exports/share/applications
PathModified=@HOME@/.local/share/applications
PathModified=@HOME@/.local/share/flatpak/exports/share/applications
Unit=brisa-icons.service

[Install]
WantedBy=default.target
